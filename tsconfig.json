{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "lib": ["ESNext"],
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist/",
    "downlevelIteration": true,
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
