{
  "name": "calendar-api",
  "version": "2.0.0-alpha2",
  "description": "Calendar API for the Pirate Party of Rhein-Erft-Kreis",
  "main": "dist/app.js",
  "repository": "git@github.com:Piraten-REK/calendar-api.git",
  "author": "Mike Kühnapfel <mike.kuehnapfel@piraten-rek.de>",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@tsconfig/node-lts": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "rollup": "^4.24.4",
    "tracer": "^1.3.0",
    "ts-standard": "^12.0.2",
    "typescript": "^5.6.3"
  },
  "ts-standard": {
    "ignore": [
      "node_modules/**",
      "bin/**",
      "**/*.d.ts"
    ]
  },
  "standard": {
    "ignore": [
      "**/*.d.ts"
    ]
  },
  "dependencies": {
    "express": "^4.21.1",
    "ical.js": "^2.1.0",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "if [ ! -f '.env' ]; then cp .env.sample .env; fi; node dist/app.js",
    "build": "rollup -c",
    "dev": "ENVIRONMENT=DEVELOPMENT rollup -c --watch"
  },
  "pnpm": {
    "override": {
      "typescript": "$typescript"
    }
  }
}
